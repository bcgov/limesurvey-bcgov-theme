{% if (aSurveyInfo.printPdf == 1) %} 
{{ include('./subviews/printanswers/printanswers_style.twig') }}
<style> 
    body{ 
        font-size: 11pt;
        line-height: 80%; 
    } 
    div{
        margin: 0;
        padding: 0;
    }
    .question-container-printanswers{
        line-height: 125%;
    }
</style> 
{% endif %}
{# {{dump(aSurveyInfo.groupArray)}} #}
<div>
    {% if (aSurveyInfo.printPdf != 1) %} 
        <h1 class="underlined-title export" {{ aSurveyInfo.attr.savecontainertitle }}>{{ gT("Print answers") }}</h1>
        <div class="row export">
            <div>
                {{ C.Html.form(aSurveyInfo.printAnswersHeadFormUrl, 'post') }}
                    <button type="submit" class="btn btn-lg btn-secondary bcgov-arrow-button">
                        <span class="fa fa-file-pdf-o"></span>
                        &nbsp;
                        {{ gT("Export as Regular PDF") }}
                    </button>
                {{ C.Html.endForm }}
            </div>
            <div>
                {{ C.Html.form(aSurveyInfo.printAnswersHeadFormQueXMLUrl, 'post') }}
                    <button type="submit" class="btn btn-lg btn-secondary bcgov-arrow-button">
                        <span class="fa fa-file-text-o"></span>
                        &nbsp;
                        {{ gT("Export as QueXML PDF") }}
                    </button>
                {{ C.Html.endForm }}
            </div>
        </div>
    {% endif %}



